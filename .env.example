# Public Firebase web config for project myfirstproject-76495.
# The same values are the defaults in src/firebaseConfig.ts.
# Copy a line into .env.local only when you want to override a default.
# .env.local is gitignored. Do not commit it.
#
# The apiKey is a public client identifier. The App Check debug token is a secret.
# A token in VITE_FIREBASE_APPCHECK_DEBUG_TOKEN is compiled into the extension
# build, so prefer the side panel field for everyday use and keep this file empty
# of tokens. npm run smoke:cloud reads the token from the environment or .env.local.

VITE_FIREBASE_API_KEY=AIzaSyAYlQ2CIC0tYI5YQhAvyJL-MJx547JyXqM
VITE_FIREBASE_AUTH_DOMAIN=myfirstproject-76495.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=myfirstproject-76495
VITE_FIREBASE_STORAGE_BUCKET=myfirstproject-76495.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=743316150934
VITE_FIREBASE_APP_ID=1:743316150934:web:1d298ce2ca25741634c0b7

# Secret. Leave empty here. Set it in .env.local:
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Public reCAPTCHA Enterprise site key. Also the default in src/firebaseConfig.ts.
# Manifest V3 extension pages cannot load the remote reCAPTCHA script, so the
# extension still needs VITE_FIREBASE_APPCHECK_DEBUG_TOKEN or the side-panel field.
VITE_FIREBASE_RECAPTCHA_ENTERPRISE_SITE_KEY=6Lf28icuAAAAAI_YndgCvuy1eAJeaq5Bjo0wL6Bb

# Optional. Only needed for Google sign-in (Anonymous sign-in does not need it).
VITE_GOOGLE_OAUTH_CLIENT_ID=

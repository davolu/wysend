# Copy to .env and fill in from the Firebase console.
# Project settings → Your apps → Web app → SDK setup and configuration.
# Do not commit .env. Rebuild after changes: npm run build
#
# The apiKey is a public client identifier, not a server secret.
# The App Check debug token IS a secret. Prefer saving it in the side panel
# (stored only in chrome.storage.local) instead of this file. If you put it
# here, it is embedded in the local build. Never commit it and never ship
# that dist publicly.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Leave empty and use the side panel "App Check" field instead.
VITE_APPCHECK_DEBUG_TOKEN=

# Optional production attestation for a hosted web page.
# Manifest V3 extension pages cannot load the remote reCAPTCHA script, so
# this key does not attest the extension. Use a debug token for the extension.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Optional. Only needed for Google sign-in (Anonymous sign-in does not need it).
VITE_GOOGLE_OAUTH_CLIENT_ID=
